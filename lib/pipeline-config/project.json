{
  "name": "pipeline-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/pipeline-config/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared", "domain:pipeline"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm build",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "{projectRoot}"
      }
    }
  }
}
