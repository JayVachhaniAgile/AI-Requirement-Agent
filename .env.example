# Backend (NestJS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_platform
PORT=3000
NODE_ENV=development

# LLM provider: openai | groq
LLM_PROVIDER=groq

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Groq (when LLM_PROVIDER=groq) — OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend (Vite) — optional; defaults to proxying /api → localhost:3000
# VITE_API_PROXY=http://localhost:3000
# PORT=5173
# BASE_PATH=/
