# Frontend (Vite) — copy to apps/client/.env for local overrides

# Dev proxy target for /api and /socket.io (vite.config.ts)
# Match apps/server PORT (default 3000; this repo often uses 7509).
VITE_API_PROXY=http://localhost:7509

# Absolute API origin when the SPA is not same-origin with the backend.
# Leave unset to use relative /api paths (recommended with the Vite proxy).
# VITE_API_URL=http://localhost:7509

# API key when backend REQUIRE_AUTH=true or NODE_ENV=production with API_KEY set.
# Sent as Authorization: Bearer <key> and X-Api-Key.
# VITE_API_KEY=

# Socket.IO origin; defaults to window.location.origin (Vite proxy in dev).
# VITE_SOCKET_URL=http://localhost:7509

# Dev server
PORT=5173
BASE_PATH=/
