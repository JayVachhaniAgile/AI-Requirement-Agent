{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-scripts",
    "rootDir": "./scripts",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "module": "commonjs",
    "esModuleInterop": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-scripts"]
}
