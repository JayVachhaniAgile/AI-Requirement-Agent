age.service.spec.js /tmp/crystallize-test-dist/foundation/artifacts/artifact-registry.service.spec.js /tmp/crystallize-test-dist/foundation/canonical/canonical.schemas.spec.js /tmp/crystallize-test-dist/foundation/canonical/canonical.validate.spec.js /tmp/crystallize-test-dist/foundation/canonical/canonical-model.service.spec.js /tmp/crystallize-test-dist/foundation/artifacts/artifact-dependency.service.spec.js /tmp/crystallize-test-dist/foundation/artifacts/impact-analysis.service.spec.js /tmp/crystallize-test-dist/foundation/context/context-dependency.spec.js /tmp/crystallize-test-dist/foundation/context/context.ranker.spec.js /tmp/crystallize-test-dist/foundation/context/context.token-budget.spec.js /tmp/crystallize-test-dist/foundation/context/context.cache.spec.js /tmp/crystallize-test-dist/foundation/context/context-engine.service.spec.js",
    "eval:golden": "node eval/run-golden-eval.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
