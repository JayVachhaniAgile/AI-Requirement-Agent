# Backend (NestJS) — copy to apps/server/.env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_platform
PORT=3000
NODE_ENV=development

# LLM provider: openai | groq | ollama | custom | anthropic | openrouter | …
# Use the generic LLM_* vars below — switch provider/model/key without renaming keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
# LLM_BASE_URL=                 # optional; required for custom/anthropic/openrouter gateways
#                               # defaults: groq→api.groq.com, ollama→localhost:11434/v1

# Legacy provider-specific keys still work as fallbacks if LLM_* are unset:
# OPENAI_API_KEY= / OPENAI_MODEL=
# GROQ_API_KEY= / GROQ_MODEL= / GROQ_BASE_URL=
# OLLAMA_BASE_URL= / OLLAMA_MODEL= / OLLAMA_API_KEY=
# CUSTOM_LLM_BASE_URL= / CUSTOM_LLM_MODEL= / CUSTOM_LLM_API_KEY=

# Per-tier model overrides (optional)
# LLM_MODEL_HIGH=
# LLM_MODEL_STANDARD=
# LLM_MODEL_FAST=

# Optional global max_tokens cap (alias: AGENT_MAX_TOKENS)
# LLM_MAX_TOKENS=16384
# AGENT_MAX_TOKENS=10000

# Per-request LLM timeout in milliseconds (default 120000).
LLM_TIMEOUT_MS=120000

# === SECURITY / TIMEOUTS ===
# Comma-separated list of allowed CORS origins (defaults to local dev ports).
# Set to a single "*" to allow all origins (not recommended in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Require API key auth (also forced when NODE_ENV=production).
# REQUIRE_AUTH=true
# API_KEY=
# Production DB TLS: set true to reject unauthorized certs (default false).
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Heavy-endpoint rate limit (recompile/regenerate/gap-analysis/start).
# HEAVY_RATE_LIMIT_WINDOW_MS=60000
# HEAVY_RATE_LIMIT_MAX=10

# === PIPELINE TUNING ===
# SKIP_VALIDATION=true  # bypass validation/retries (dev only)
# AGENT_VALIDATION_MAX_RETRIES=2
# DAG_CONCURRENCY=5
# GAP_ANALYSIS_TIMEOUT_MS=900000

# === FOUNDATION ARCHITECTURE ===
# Canonical dual-write: persist validated canonical items from every agent output.
FOUNDATION_CANONICAL_WRITE=true
# Per-stage quality evaluation after every agent completes.
FOUNDATION_QUALITY_PER_STAGE=true
# Auto-compile compiled documents when the compilation node completes.
FOUNDATION_COMPILER_AUTO=false
# Full project quality evaluation at pipeline completion.
FOUNDATION_AUTO_QUALITY=true

# Context token budgets (optional overrides)
# CONTEXT_BUDGET_REQUIREMENTS=12000
# CONTEXT_BUDGET_UX=8000
# CONTEXT_BUDGET_DATABASE=10000
# CONTEXT_BUDGET_SECURITY=8000
# CONTEXT_BUDGET_ARCHITECTURE=12000

# Migration feature flags (optional)
# MIGRATION_MODE=legacy
# MIGRATION_MIN_QUALITY_SCORE=
# MIGRATION_MAX_COST_USD=
# MIGRATION_MAX_LATENCY_MS=

# === FRONTEND (Vite) — set in apps/client/.env or shell ===
# VITE_API_PROXY=http://localhost:3000
# VITE_API_URL=                 # absolute API origin when not same-origin (e.g. https://api.example.com)
# VITE_API_KEY=                 # sent as Authorization Bearer + X-Api-Key when backend auth is on
# VITE_SOCKET_URL=              # Socket.IO origin; defaults to window.location.origin
# PORT=5173
# BASE_PATH=/
